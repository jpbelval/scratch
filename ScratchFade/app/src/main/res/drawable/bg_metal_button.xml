<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#333F7CE0">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <solid android:color="#2F6FBF" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="6dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#98A0AA"
                        android:endColor="#737B86"
                        android:startColor="#C2C8D0" />
                    <stroke
                        android:width="1dp"
                        android:color="#69717C" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</ripple>
